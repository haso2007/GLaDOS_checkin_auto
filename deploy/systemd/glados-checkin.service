[Unit]
Description=GLaDOS native Chromium check-in service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=glados
Group=glados
WorkingDirectory=/opt/glados-checkin
EnvironmentFile=-/etc/glados-checkin/glados-checkin.env
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/glados-checkin
Environment=XDG_CACHE_HOME=/var/lib/glados-checkin/cache
Environment=XDG_CONFIG_HOME=/var/lib/glados-checkin/config
Environment=XDG_RUNTIME_DIR=/run/glados-checkin
RuntimeDirectory=glados-checkin
RuntimeDirectoryMode=0700
UMask=0077
ExecStart=/opt/glados-checkin/deploy/debian/run-service.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
