# Installed as /etc/glados-checkin/glados-checkin.env (root:glados, 0640).
# Keep Cookies and proxy credentials in /var/lib/glados-checkin/config.json via the UI,
# never in this environment file. WEB_HOST must remain loopback on this branch.

WEB_HOST=127.0.0.1
WEB_PORT=3000
GLADOS_DATA_DIR=/var/lib/glados-checkin
GLADOS_BROWSER_PROFILE_DIR=/var/lib/glados-checkin/profiles
# Leave empty to auto-detect chromium on PATH or /usr/bin/chromium.
GLADOS_CHROMIUM_EXECUTABLE=
